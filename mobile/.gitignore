# Flutter/Dart build artifacts -- created by `flutter create .` and
# `flutter pub get`, never hand-edited, never committed.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# pubspec.lock IS committed here on purpose -- this is an app, not a
# package, so the lockfile should be tracked for reproducible builds.

# Platform build output (the android/, ios/ project files themselves are
# committed once `flutter create .` generates them -- just not their
# build output).
android/.gradle/
android/app/build/
android/local.properties
android/key.properties
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# IDE
.idea/
*.iml
